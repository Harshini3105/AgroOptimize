# AgroOptimize Environment Configuration
#
# NOTE (current status): app/config.py hardcodes these as plain Python
# constants today and does not yet read from the environment or a .env
# file -- there's no python-dotenv wiring in app/ yet. This file documents
# the knobs that already exist in config.py so they're easy to find, and
# doubles as the template for whoever wires up env-based overrides later
# (see docs/future_work.md). Copy to `.env` once that wiring exists.

# Directories (app/config.py: RAW_DATA_DIR, RESULTS_DIR)
DATA_DIR=data/raw
RESULTS_DIR=results
LOG_LEVEL=INFO

# NSGA-II parameters (app/config.py: NSGA2_POP_SIZE, NSGA2_N_GEN,
# NSGA2_CROSSOVER_PROB, NSGA2_MUTATION_PROB -- paper-matching defaults)
NSGA2_POPULATION=80
NSGA2_GENERATIONS=200
NSGA2_CROSSOVER_PROB=0.85
NSGA2_MUTATION_PROB=0.12

# API (uvicorn app.main:app --host $API_HOST --port $API_PORT --reload)
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
